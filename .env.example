# App
PORT=3000
APP_BASE_URL=http://localhost:3000

# Storage
# Default: postgres automatically when DATABASE_URL is set, otherwise json.
# For local zero-setup development you can force: STORAGE_DRIVER=json
STORAGE_DRIVER=
DATA_FILE=./data/db.json
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PUBLISH_MAX_RETRIES=3
PUBLISH_RETRY_BASE_MS=500

# OpenAI - intelligence and content generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901524471002
CLICKUP_STATUS_IN_REVIEW=in review
CLICKUP_STATUS_READY=ready
CLICKUP_STATUS_PUBLISHED=published

# Publishing mode: clickup_watch mirrors the current Ghaith Web workflow.
# Make can remain disabled while the rest of the application is configured.
PUBLISH_MODE=clickup_watch
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Google Drive
# Prefer OAuth refresh credentials for long-running production use.
# GOOGLE_DRIVE_ACCESS_TOKEN remains available for short-lived/manual testing.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Semrush v4 keyword metrics
SEMRUSH_API_URL=https://api.semrush.com/apis/v4/keywords/v1/metrics
SEMRUSH_API_KEY=
SEMRUSH_COUNTRY=TN

# Canva
# Direct access token is suitable for connection testing; production OAuth token persistence is the next phase.
# Legacy webhook remains supported as a fallback.
CANVA_ACCESS_TOKEN=
CANVA_AUTOMATION_WEBHOOK_URL=

# HeyGen direct API (webhook fallback remains supported)
HEYGEN_API_KEY=
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_AVATAR_TYPE=photo_avatar
HEYGEN_AUTOMATION_WEBHOOK_URL=

# Platform list is data, not code. Add X or any new platform here.
SUPPORTED_PLATFORMS=facebook,instagram,tiktok,pinterest,youtube,x

# App
PORT=3000
APP_BASE_URL=http://localhost:3000

# Storage
STORAGE_DRIVER=
DATA_FILE=./data/db.json
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PUBLISH_MAX_RETRIES=3
PUBLISH_RETRY_BASE_MS=500

# AI — FREE FIRST
# Default path: Gemini Free Tier. Create a key in Google AI Studio and set it in Vercel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Keep false to guarantee that OpenAI / AI Gateway cannot be used accidentally.
ALLOW_PAID_AI=false

# Optional paid AI fallbacks — ignored while ALLOW_PAID_AI=false.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901524471002
CLICKUP_STATUS_IN_REVIEW=in review
CLICKUP_STATUS_READY=ready
CLICKUP_STATUS_PUBLISHED=published

# Publishing transport.
# clickup_watch keeps the current fixed ClickUp → Make watcher contract.
# webhook sends the normalized payload to any compatible endpoint: Make, n8n, or your own API.
PUBLISH_MODE=clickup_watch
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=
# Optional alternate generic aliases accepted by the app.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
# Legacy Make aliases remain supported for backward compatibility.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Google Drive — persistent OAuth preferred.
# Add CLIENT_ID + CLIENT_SECRET, then open /api/integrations/google-drive/connect.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Manual/legacy fallback only; normal OAuth stores the refresh token in the app database.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Least-privilege default. Avoid broad drive scope unless explicitly required.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
# Leave blank to let the app create and remember its own export folder after OAuth.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Ghaith Web Content OS — Runtime Exports

# Semrush v4 keyword metrics
SEMRUSH_API_URL=https://api.semrush.com/apis/v4/keywords/v1/metrics
SEMRUSH_API_KEY=
SEMRUSH_COUNTRY=TN

# Canva — PRIMARY ASSET FACTORY
# Production: prefer OAuth. CANVA_ACCESS_TOKEN is only a short-lived/manual fallback.
CANVA_ACCESS_TOKEN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_SCOPES=design:content:read design:content:write design:meta:read asset:read asset:write profile:read
CANVA_BRAND_KIT_ID=kAHON_7IACY
# Saved Ghaith Web master designs (non-secret defaults also exist in code).
CANVA_SOCIAL_DESIGN_ID=DAHSrPK5pN0
CANVA_CAROUSEL_DESIGN_ID=DAHSrGq1HWk
CANVA_VIDEO_DESIGN_ID=DAHSrIr1gMw
# Optional fallback: Brand Template IDs.
CANVA_SOCIAL_TEMPLATE_ID=
CANVA_CAROUSEL_TEMPLATE_ID=
CANVA_VIDEO_TEMPLATE_ID=
CANVA_VIDEO_EXPORT_QUALITY=vertical_1080p
CANVA_AUTOFILL_TITLE_FIELD=TITLE
CANVA_AUTOFILL_BODY_FIELD=BODY
CANVA_AUTOFILL_CTA_FIELD=CTA
CANVA_AUTOFILL_MEDIA_FIELD=MEDIA
CANVA_AUTOMATION_WEBHOOK_URL=

# HeyGen — optional presenter source routed through an approved Make/HeyGen connector.
# Direct legacy v1/v2 HTTP generation is intentionally not used by the app.
HEYGEN_AUTOMATION_WEBHOOK_URL=

# Remotion — primary professional motion renderer. Vercel enables this automatically.
# Set true only in another runtime that has valid Vercel Sandbox credentials.
REMOTION_ENABLED=

SUPPORTED_PLATFORMS=facebook,instagram,tiktok,pinterest,youtube,x

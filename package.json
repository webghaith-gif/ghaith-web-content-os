{
  "name": "ghaith-web-content-os",
  "version": "2.0.0",
  "private": true,
  "description": "Ghaith Web Content OS web app: intelligence → content → approval → ClickUp READY → Make → publishing → analytics",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env -r ts-node/register/transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node --env-file=.env dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate:postgres": "npm run build && node --env-file=.env dist/src/scripts/migrate-json-to-postgres.js"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "pdf-lib": "1.17.1",
    "pg": "8.22.0",
    "sharp": "0.34.3",
    "web-push": "3.6.7"
  }
}